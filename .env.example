# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

DB_HOST=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=enrollment_system_min

# Address of the Laravel module (enrollment-module/), used by the menu links.
#   php artisan serve --port=8001 :  http://localhost:8001
#   XAMPP Apache (project in htdocs): http://localhost/<folder>/enrollment-module/public
LARAVEL_URL=http://localhost:8001

# 1 = show error details in API responses (development only), 0 = hide them
APP_DEBUG=0
